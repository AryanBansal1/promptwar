# Copy to .env for local development. Never commit .env.
# production | development | test. Production refuses to start without GEMINI_API_KEY.
ENV=development
# Get a key at https://aistudio.google.com/apikey. In Cloud Run this comes from Secret Manager.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# 0 turns off "thinking" on Flash models for faster answers; -1 leaves the model default.
GEMINI_THINKING_BUDGET=0
LLM_TIMEOUT_SECONDS=20
AI_RATE_LIMIT_PER_MINUTE=12
# JSON list of extra origins allowed by CORS. Empty = same origin only.
ALLOWED_ORIGINS=[]
LOG_LEVEL=INFO
